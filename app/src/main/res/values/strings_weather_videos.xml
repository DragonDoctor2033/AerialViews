    <string name="weather_videos_override_off">Off</string>
    <string name="weather_videos_override_clear">Clear</string>
    <string name="weather_videos_override_cloudy">Cloudy</string>
    <string name="weather_videos_override_rain">Rain</string>
    <string name="weather_videos_override_snow">Snow</string>
