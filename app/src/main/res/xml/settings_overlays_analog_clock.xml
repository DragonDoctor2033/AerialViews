<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <PreferenceCategory app:title="@string/category_analog_clock">
                <ListPreference
                    app:defaultValue="@string/analog_clock_size_default"
                    app:entries="@array/analog_clock_size_entries"
                    app:entryValues="@array/analog_clock_size_values"
                    app:key="analog_clock_size"
                    app:title="@string/analog_clock_size_title"
                    app:useSimpleSummaryProvider="true" />

                <CheckBoxPreference
                    app:defaultValue="true"
                    app:key="analog_clock_show_second_hand"
                    app:summary="@string/analog_clock_show_second_hand_summary"
                    app:title="@string/analog_clock_show_second_hand_title" />

                <ListPreference
                    app:defaultValue="@string/analog_clock_second_hand_motion_default"
                    app:dependency="analog_clock_show_second_hand"
                    app:entries="@array/analog_clock_second_hand_motion_entries"
                    app:entryValues="@array/analog_clock_second_hand_motion_values"
                    app:key="analog_clock_second_hand_motion"
                    app:title="@string/analog_clock_second_hand_motion_title"
                    app:useSimpleSummaryProvider="true" />

                <ListPreference
                    app:defaultValue="@string/analog_clock_halo_default"
                    app:entries="@array/analog_clock_halo_entries"
                    app:entryValues="@array/analog_clock_halo_values"
                    app:key="analog_clock_halo"
                    app:title="@string/analog_clock_halo_title"
                    app:useSimpleSummaryProvider="true" />
        </PreferenceCategory>

        <PreferenceCategory app:title="@string/category_analog_clock_center">
                <CheckBoxPreference
                    app:defaultValue="false"
                    app:key="analog_clock_show_in_center"
                    app:summary="@string/analog_clock_show_in_center_summary"
                    app:title="@string/analog_clock_show_in_center_title" />

                <ListPreference
                    app:defaultValue="@string/analog_clock_center_size_default"
                    app:dependency="analog_clock_show_in_center"
                    app:entries="@array/analog_clock_center_size_entries"
                    app:entryValues="@array/analog_clock_center_size_values"
                    app:key="analog_clock_center_size"
                    app:title="@string/analog_clock_center_size_title"
                    app:useSimpleSummaryProvider="true" />
        </PreferenceCategory>
</PreferenceScreen>
