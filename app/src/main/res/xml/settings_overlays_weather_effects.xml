<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <PreferenceCategory app:title="@string/category_weather_effects">
                <CheckBoxPreference
                    app:defaultValue="true"
                    app:key="weather_effects_enabled"
                    app:summary="@string/weather_effects_enabled_summary"
                    app:title="@string/weather_effects_enabled_title" />

                <ListPreference
                    app:defaultValue="@string/weather_effects_intensity_default"
                    app:dependency="weather_effects_enabled"
                    app:entries="@array/weather_effects_intensity_entries"
                    app:entryValues="@array/weather_effects_intensity_values"
                    app:key="weather_effects_intensity"
                    app:title="@string/weather_effects_intensity_title"
                    app:useSimpleSummaryProvider="true" />

                <CheckBoxPreference
                    app:defaultValue="true"
                    app:dependency="weather_effects_enabled"
                    app:key="weather_effects_skip_on_weather_clips"
                    app:summary="@string/weather_effects_skip_summary"
                    app:title="@string/weather_effects_skip_title" />

                <ListPreference
                    app:defaultValue="@string/weather_effects_frame_rate_default"
                    app:dependency="weather_effects_enabled"
                    app:entries="@array/weather_effects_frame_rate_entries"
                    app:entryValues="@array/weather_effects_frame_rate_values"
                    app:key="weather_effects_frame_rate"
                    app:title="@string/weather_effects_frame_rate_title"
                    app:useSimpleSummaryProvider="true" />
        </PreferenceCategory>
</PreferenceScreen>
